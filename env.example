# Backend Environment Variables
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# AI Service Configuration
# Get your Gemini API key from: https://makersuite.google.com/app/apikey
# Leave empty to use lightweight NLP matching (no AI)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Provider (gemini, openai, or both)
AI_PROVIDER=gemini

# Note: For Render deployment, set these in Render dashboard under Environment Variables
# Render will automatically set PORT, so you don't need to set it manually
# Set GEMINI_API_KEY in Render dashboard for AI-powered recommendations

