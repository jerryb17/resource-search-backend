# Backend Environment Variables
# Copy this file to .env and update with your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# Optional: Add any API keys or secrets here in the future
# EXAMPLE_API_KEY=your_api_key_here

# Note: For Render deployment, set these in Render dashboard under Environment Variables
# Render will automatically set PORT, so you don't need to set it manually

